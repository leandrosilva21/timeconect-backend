###############################################################################
# .env de produção — Time Conect Backend
# Cole isso no Railway em Variables (Settings → Variables → Raw Editor)
# Depois remova esse arquivo do repo (git rm) ou mova pro .gitignore.
###############################################################################

APP_NAME="Time Conect"
APP_ENV=production
APP_KEY=base64:n/EZUN3amj21pK2j67mPG7DPYBdGtrjZOSAp0ys3bmM=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://timeconect-backend.up.railway.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Supabase Postgres ──────────────────────────────────────────────────────────
# Pooler em modo Session (porta 5432) — recomendado pra Laravel.
# IMPORTANTE: confirme a região no Supabase → Settings → Database → Connection
# pooling. Se sua região não for sa-east-1, troque o host.
DB_CONNECTION=pgsql
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.hojgxrhjgjsosjpmovid
DB_PASSWORD=sechI4-suxzow-qycxyq
DB_SCHEMA=public
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=timeconect.vercel.app,localhost
SESSION_DRIVER=database

# Sessões/queue/cache no Postgres pra não precisar de Redis em outro lugar
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=tc_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@timeconect.app"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend → backend (CORS): aceita o domínio do Vercel
CORS_ALLOWED_ORIGINS=https://timeconect.vercel.app,http://localhost:3000
